<Window x:Class="SmsTest.VariablesApp.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:vm="clr-namespace:SmsTest.VariablesApp.ViewModels"
        xmlns:b="http://schemas.microsoft.com/xaml/behaviors"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        Title="Тестовое WPF-приложение для SmartMealService"
        Height="500" Width="1100"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        WindowStartupLocation="CenterScreen"
        d:DataContext="{d:DesignInstance Type=vm:MainViewModel, IsDesignTimeCreatable=False}">
    <!--
        Развитие:
        1) вынесение всех стилей в отдельные файлы (палитры, общие стили, специфичные стили окна и его компонентов), устранение дублирования правил оформления
        2) вынесение компонентов (AppWindow, CustomGrid) в отдельные компоненты
        3) поддержка тем
        4) поддержка локализации
    -->

    <b:Interaction.Triggers>
        <b:EventTrigger EventName="Loaded">
            <b:InvokeCommandAction Command="{Binding LoadCommand}" />
        </b:EventTrigger>
    </b:Interaction.Triggers>

    <Border Margin="15,15,40,40"
            Background="White"
            BorderBrush="White"
            BorderThickness="1"
            CornerRadius="25"
            Padding="20"
            MouseLeftButtonDown="OnMouseLeftButtonDown">

        <Border.Effect>
            <DropShadowEffect BlurRadius="30"
                              ShadowDepth="10"
                              Direction="305"
                              Opacity="0.2"
                              Color="Gray" />
        </Border.Effect>

        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="20" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <Grid Grid.Row="0" Background="Transparent">
                <TextBlock Text="Тестовое WPF-приложение для SmartMealService"
                           FontWeight="SemiBold"
                           VerticalAlignment="Bottom"
                           FontSize="18" />

                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                    <Button Click="OnMinimizeButtonClick"
                            Background="Transparent"
                            BorderThickness="0"
                            Cursor="Hand"
                            Padding="5">
                        <Path Data="M 0,0 L 23,0"
                              Stroke="Black"
                              StrokeThickness="4"
                              VerticalAlignment="Bottom"
                              HorizontalAlignment="Center"
                              Margin="0,2,0,0" />
                    </Button>

                    <Button Click="OnCloseButtonClick"
                            Background="Transparent"
                            BorderThickness="0"
                            Margin="30,0,0,0"
                            Cursor="Hand"
                            Padding="5">
                        <Path Data="M 0,0 L 20,20 M 20,0 L 0,20"
                              Stroke="Black"
                              StrokeThickness="8"
                              VerticalAlignment="Center"
                              HorizontalAlignment="Center" />
                    </Button>
                </StackPanel>
            </Grid>

            <Grid Grid.Row="2">
                <Border BorderBrush="Black"
                        BorderThickness="2"
                        CornerRadius="25"
                        Background="Transparent">
                    <Border.OpacityMask>
                        <VisualBrush>
                            <VisualBrush.Visual>
                                <Border Background="Black"
                                        CornerRadius="25"
                                        Width="{Binding ActualWidth, RelativeSource={RelativeSource AncestorType=Border}}"
                                        Height="{Binding ActualHeight, RelativeSource={RelativeSource AncestorType=Border}}" />
                            </VisualBrush.Visual>
                        </VisualBrush>
                    </Border.OpacityMask>

                    <DataGrid AutoGenerateColumns="False"
                              HeadersVisibility="All"
                              Background="Transparent"
                              RowBackground="Transparent"
                              BorderThickness="0"
                              GridLinesVisibility="All"
                              HorizontalGridLinesBrush="#8d8d8d"
                              VerticalGridLinesBrush="#8d8d8d"
                              CanUserAddRows="False"
                              CanUserDeleteRows="False"
                              CanUserReorderColumns="False"
                              CanUserSortColumns="True"
                              IsReadOnly="False"
                              ItemsSource="{Binding Items}">

                        <DataGrid.Resources>
                            <Style x:Key="DefaultColumnHeaderStyle"
                                   TargetType="DataGridColumnHeader"
                                   BasedOn="{StaticResource {x:Type DataGridColumnHeader}}">
                                <Setter Property="BorderBrush" Value="#8d8d8d" />
                                <Setter Property="BorderThickness" Value="0,0,1.5,1.5" />
                                <Setter Property="Padding" Value="10,5" />
                                <Setter Property="FontWeight" Value="500" />
                                <Setter Property="FontSize" Value="16" />
                                <Setter Property="Background" Value="White" />
                            </Style>

                            <Style x:Key="LastColumnHeaderStyle"
                                   TargetType="DataGridColumnHeader"
                                   BasedOn="{StaticResource DefaultColumnHeaderStyle}">
                                <Setter Property="BorderThickness" Value="0,0,0,1.5" />
                            </Style>

                            <Style x:Key="CellTextStyle" TargetType="TextBlock">
                                <Setter Property="Margin" Value="10,5" />
                            </Style>

                            <Style x:Key="CellEditTextStyle" TargetType="TextBox">
                                <Setter Property="Padding" Value="10,5" />
                                <Setter Property="BorderThickness" Value="0" />
                                <Setter Property="Background" Value="White" />
                            </Style>

                            <Style
                                x:Key="{ComponentResourceKey ResourceId=DataGridSelectAllButtonStyle, TypeInTargetAssembly={x:Type DataGrid}}"
                                TargetType="{x:Type Button}">
                                <Setter Property="OverridesDefaultStyle" Value="True" />
                                <Setter Property="Background" Value="White" />
                                <Setter Property="BorderBrush" Value="#8d8d8d" />
                                <Setter Property="BorderThickness" Value="0,0,1.5,1.5" />
                                <Setter Property="Template">
                                    <Setter.Value>
                                        <ControlTemplate TargetType="Button">
                                            <Border Background="{TemplateBinding Background}"
                                                    BorderBrush="{TemplateBinding BorderBrush}"
                                                    BorderThickness="{TemplateBinding BorderThickness}" />
                                        </ControlTemplate>
                                    </Setter.Value>
                                </Setter>
                            </Style>
                        </DataGrid.Resources>

                        <DataGrid.CellStyle>
                            <Style TargetType="DataGridCell"
                                   BasedOn="{StaticResource {x:Type DataGridCell}}">
                                <Setter Property="FontWeight" Value="400" />
                                <Setter Property="FontSize" Value="15" />
                            </Style>
                        </DataGrid.CellStyle>

                        <DataGrid.RowHeaderStyle>
                            <Style TargetType="DataGridRowHeader">
                                <Setter Property="Background" Value="Transparent" />
                                <Setter Property="BorderBrush" Value="#8d8d8d" />
                                <Setter Property="BorderThickness" Value="0,0,1.5,1.5" />
                                <Setter Property="Width" Value="50" />
                                <Setter Property="Template">
                                    <Setter.Value>
                                        <ControlTemplate TargetType="DataGridRowHeader">
                                            <Border Background="{TemplateBinding Background}"
                                                    BorderBrush="{TemplateBinding BorderBrush}"
                                                    BorderThickness="{TemplateBinding BorderThickness}">
                                                <Path x:Name="Indicator"
                                                      Data="M 0,0 L 6,5 L 0,10 Z"
                                                      Fill="Black"
                                                      Margin="7,0,0,0"
                                                      HorizontalAlignment="Left"
                                                      VerticalAlignment="Center"
                                                      Visibility="Collapsed" />
                                            </Border>
                                            <ControlTemplate.Triggers>
                                                <DataTrigger
                                                    Binding="{Binding IsSelected, RelativeSource={RelativeSource AncestorType=DataGridRow}}"
                                                    Value="True">
                                                    <Setter TargetName="Indicator"
                                                            Property="Visibility"
                                                            Value="Visible" />
                                                </DataTrigger>
                                            </ControlTemplate.Triggers>
                                        </ControlTemplate>
                                    </Setter.Value>
                                </Setter>
                            </Style>
                        </DataGrid.RowHeaderStyle>


                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Поле" Width="200" Binding="{Binding Name}"
                                                IsReadOnly="True"
                                                HeaderStyle="{StaticResource DefaultColumnHeaderStyle}"
                                                ElementStyle="{StaticResource CellTextStyle}"
                                                EditingElementStyle="{StaticResource CellEditTextStyle}" />
                            <DataGridTextColumn Header="Значение" Width="200" Binding="{Binding Value}"
                                                HeaderStyle="{StaticResource DefaultColumnHeaderStyle}"
                                                ElementStyle="{StaticResource CellTextStyle}"
                                                EditingElementStyle="{StaticResource CellEditTextStyle}" />
                            <DataGridTextColumn Header="Комментарий" Width="*" Binding="{Binding Comment}"
                                                HeaderStyle="{StaticResource LastColumnHeaderStyle}"
                                                ElementStyle="{StaticResource CellTextStyle}"
                                                EditingElementStyle="{StaticResource CellEditTextStyle}" />
                        </DataGrid.Columns>
                    </DataGrid>
                </Border>

                <Border BorderBrush="Black"
                        BorderThickness="2"
                        CornerRadius="25"
                        Background="Transparent"
                        IsHitTestVisible="False" />
            </Grid>
        </Grid>
    </Border>
</Window>