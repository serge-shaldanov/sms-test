<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <OutputType>Exe</OutputType>
        <TargetFramework>net8.0</TargetFramework>
        <ImplicitUsings>enable</ImplicitUsings>
        <Nullable>enable</Nullable>
        <Configurations>Debug;Release;RestApp;GrpcApp</Configurations>
        <Platforms>AnyCPU</Platforms>
    </PropertyGroup>

    <ItemGroup>
        <None Update="appsettings.json">
            <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
        </None>
    </ItemGroup>

    <ItemGroup>
        <PackageReference Include="Microsoft.Extensions.Configuration" Version="10.0.12"/>
        <PackageReference Include="WireMock.Grpc.Protobuf" Version="1.2.0"/>
        <PackageReference Include="WireMock.Net" Version="2.15.0"/>
    </ItemGroup>

    <ItemGroup>
        <ProjectReference Include="..\SmsTest.OrdersApi.Grpc.Contracts\SmsTest.OrdersApi.Grpc.Contracts.csproj"/>
    </ItemGroup>

</Project>
